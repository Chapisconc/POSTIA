r(--c-muted)]\" data-kid=\"2-4-2-1-2-1-6-1-1\">\n                                    CAMBIO A DEVOLVER\n                                </p>\n                                <p class=\"mono text-[24px] font-bold leading-tight mt-0.5\" data-dynamic=\"true\" data-kid=\"2-4-2-1-2-1-6-1-2\" data-name=\"payment change amount\" data-reason=\"amount updated by script on keypad input\" id=\"change\">\n                                    $0.00\n                                </p>\n                            </div>\n                            <p class=\"ml-auto text-[12.5px] font-semibold text-right max-w-[190px]\" data-kid=\"2-4-2-1-2-1-6-2\" id=\"changeMsg\">\n                                Falta capturar el monto\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"p-5\" data-kid=\"2-4-2-1-2-2\">\n                        <p class=\"text-[10px] font-semibold tracking-[0.12em] text-[var(--c-muted)] mb-2\" data-kid=\"2-4-2-1-2-2-1\">\n                            TECLADO\n                        </p>\n                        <div class=\"kpad grid grid-cols-3 rounded-[6px] overflow-hidden border border-[var(--c-line)] bg-[var(--c-card)]\" data-kid=\"2-4-2-1-2-2-2\">\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"1\" data-kid=\"2-4-2-1-2-2-2-1\">\n                                1\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"2\" data-kid=\"2-4-2-1-2-2-2-2\">\n                                2\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"3\" data-kid=\"2-4-2-1-2-2-2-3\">\n                                3\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"4\" data-kid=\"2-4-2-1-2-2-2-4\">\n                                4\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"5\" data-kid=\"2-4-2-1-2-2-2-5\">\n                                5\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"6\" data-kid=\"2-4-2-1-2-2-2-6\">\n                                6\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"7\" data-kid=\"2-4-2-1-2-2-2-7\">\n                                7\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"8\" data-kid=\"2-4-2-1-2-2-2-8\">\n                                8\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"9\" data-kid=\"2-4-2-1-2-2-2-9\">\n                                9\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"00\" data-kid=\"2-4-2-1-2-2-2-10\">\n                                00\n                            </button>\n                            <button class=\"h-16 mono text-[19px] font-semibold\" data-k=\"0\" data-kid=\"2-4-2-1-2-2-2-11\">\n                                0\n                            </button>\n                            <button aria-label=\"Borrar\" class=\"h-16 grid place-items-center\" data-k=\"del\" data-kid=\"2-4-2-1-2-2-2-12\">\n                                <i class=\"ti ti-backspace text-[21px]\" data-kid=\"2-4-2-1-2-2-2-12-1\">\n                                </i>\n                            </button>\n                        </div>\n                        <button class=\"mt-3 w-full h-[60px] rounded-[6px] bg-[var(--c-ink)] text-white border-b-[3px] border-[var(--c-accent)] text-[15px] font-semibold hover:bg-[#111a2c] disabled:opacity-40 disabled:cursor-not-allowed\" data-kid=\"2-4-2-1-2-2-3\" id=\"payConfirm\">\n                            Confirmar cobro\n                        </button>\n                        <button class=\"mt-2 w-full h-11 rounded-[6px] border border-[var(--c-line)] text-[13px] font-semibold text-[var(--c-ink-2)] hover:bg-[var(--c-line-2)]\" data-close=\"\" data-kid=\"2-4-2-1-2-2-4\">\n                            Cancelar\n                        </button>\n                    </div>\n                </div>\n                <div class=\"hidden px-6 py-10 text-center\" data-kid=\"2-4-2-1-3\" id=\"paySuccess\">\n                    <div class=\"okpop inline-grid place-items-center w-16 h-16 rounded-[8px] bg-[var(--c-listo)] text-white mb-4\" data-kid=\"2-4-2-1-3-1\">\n                        <i class=\"ti ti-check text-[34px]\" data-kid=\"2-4-2-1-3-1-1\">\n                        </i>\n                    </div>\n                    <h4 class=\"text-[22px] font-bold\" data-dynamic=\"true\" data-kid=\"2-4-2-1-3-2\" data-name=\"payment confirmation status text\" data-reason=\"text set by script on success\">\n                        Cobro registrado\n                    </h4>\n                    <p class=\"text-[13.5px] text-[var(--c-muted)] mt-1\" data-kid=\"2-4-2-1-3-3\">\n                        Pedido\n                        <span class=\"mono\" data-dynamic=\"true\" data-kid=\"2-4-2-1-3-3-1\" data-name=\"confirmation order number\" data-reason=\"text set by script on success\">\n                            #A-1043\n                        </span>\n                        ·\n                        <span data-dynamic=\"true\" data-kid=\"2-4-2-1-3-3-2\" data-name=\"confirmation method\" data-reason=\"text set by script on success\" id=\"okMethod\">\n                            Efectivo\n                        </span>\n                        ·\n                        <span class=\"mono\" data-dynamic=\"true\" data-kid=\"2-4-2-1-3-3-3\" data-name=\"confirmation total amount\" data-reason=\"text set by script on success\" id=\"okTotal\">\n                            $0.00\n                        </span>\n                    </p>\n                    <div class=\"mt-5 inline-flex items-end gap-3 rounded-[6px] border border-[var(--c-line)] px-5 py-3\" data-kid=\"2-4-2-1-3-4\">\n                        <div class=\"text-left\" data-kid=\"2-4-2-1-3-4-1\">\n                            <p class=\"text-[10px] font-semibold tracking-[0.12em] text-[var(--c-muted)]\" data-kid=\"2-4-2-1-3-4-1-1\">\n                                CAMBIO A DEVOLVER\n                            </p>\n                            <p class=\"mono text-[30px] font-bold leading-tight\" data-dynamic=\"true\" data-kid=\"2-4-2-1-3-4-1-2\" data-name=\"confirmation change amount\" data-reason=\"text set by script on success\" id=\"okChange\">\n                                $0.00\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 flex items-center justify-center gap-2\" data-kid=\"2-4-2-1-3-5\">\n                        <button class=\"h-11 px-4 rounded-[6px] border border-[var(--c-line)] text-[13px] font-semibold text-[var(--c-ink-2)] hover:bg-[var(--c-line-2)] flex items-center gap-1.5\" data-kid=\"2-4-2-1-3-5-1\">\n                            <i class=\"ti ti-printer text-[17px]\" data-kid=\"2-4-2-1-3-5-1-1\">\n                            </i>\n                            Imprimir ticket\n                        </button>\n                        <button class=\"h-11 px-5 rounded-[6px] bg-[var(--c-ink)] text-white border-b-[3px] border-[var(--c-accent)] text-[13.5px] font-semibold\" data-close=\"\" data-kid=\"2-4-2-1-3-5-2\">\n                            Nuevo pedido\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (function(){\n  const PX = (p,w) => 'https://images.pexels.com/photos/'+p+'?auto=compress&cs=tinysrgb&w='+w+'&q=80';\n\n  const CATS = [\n    {k:'top',    n:'Más vendidos', i:'ti-star'},\n    {k:'alitas', n:'Alitas',       i:'ti-meat'},\n    {k:'bone',   n:'Boneless',     i:'ti-soup'},\n    {k:'burger', n:'Hamburguesas', i:'ti-bread'},\n    {k:'veg',    n:'Vegetales',    i:'ti-salad'},\n    {k:'entr',   n:'Entradas',     i:'ti-pizza'},\n    {k:'beb',    n:'Bebidas',      i:'ti-glass-full'},\n    {k:'post',   n:'Postres',      i:'ti-ice-cream'}\n  ];\n\n  const P = [\n    {id:'a10', n:'Alitas 10',            p:180, c:'alitas', top:1, custom:1, img:'36863573/pexels-photo-36863573.jpeg', by:\"César O'neill en Pexels\"},\n    {id:'a15', n:'Alitas 15',            p:250, c:'alitas', img:'36863581/pexels-photo-36863581.jpeg', by:\"César O'neill en Pexels\"},\n    {id:'a20', n:'Alitas 20',            p:320, c:'alitas', img:'10648379/pexels-photo-10648379.jpeg', by:'Angelo Greñas en Pexels'},\n    {id:'bg',  n:'Boneless grande',      p:160, c:'bone', top:1, custom:1, img:'4061475/pexels-photo-4061475.jpeg', by:'Erik Mclean en Pexels'},\n    {id:'bm',  n:'Boneless mediano',     p:110, c:'bone', img:'36863569/pexels-photo-36863569.jpeg', by:\"César O'neill en Pexels\"},\n    {id:'hc',  n:'Hamburguesa clásica',  p:95,  c:'burger', img:'4109233/pexels-photo-4109233.jpeg', by:'Polina Tankilevitch en Pexels'},\n    {id:'he',  n:'Hamburguesa especial', p:120, c:'burger', top:1, custom:1, img:'23091813/pexels-photo-23091813.jpeg', by:'Elvira Kushcheva en Pexels'},\n    {id:'hd',  n:'Hamburguesa doble',    p:150, c:'burger', img:'9814590/pexels-photo-9814590.jpeg', by:'carlos lopez en Pexels'},\n    {id:'hp',  n:'Hamburguesa de pollo', p:105, c:'burger', img:'4809146/pexels-photo-4809146.jpeg', by:'Aleksandar Ljubicic en Pexels'},\n    {id:'ec',  n:'Ensalada César',       p:80,  c:'veg', img:'13322850/pexels-photo-13322850.jpeg', by:'Valeria Boltneva en Pexels'},\n    {id:'pf',  n:'Papas a la francesa',  p:60,  c:'veg', img:'4109259/pexels-photo-4109259.jpeg', by:'Polina Tankilevitch en Pexels'},\n    {id:'dq',  n:'Dedos de queso',       p:85,  c:'entr', img:'28638538/pexels-photo-28638538.png', by:'Ruben Dao Cuentas en Pexels'},\n    {id:'ac',  n:'Aros de cebolla',      p:70,  c:'entr', img:'4109273/pexels-photo-4109273.jpeg', by:'Polina Tankilevitch en Pexels'},\n    {id:'rf',  n:'Refresco',             p:35,  c:'beb', top:1, img:'8880727/pexels-photo-8880727.jpeg', by:'Ron Lach en Pexels'},\n    {id:'lm',  n:'Limonada',             p:40,  c:'beb', img:'104509/pexels-photo-104509.jpeg', by:'AS Photography en Pexels'},\n    {id:'bw',  n:'Brownie con helado',   p:65,  c:'post', img:'5773862/pexels-photo-5773862.jpeg', by:'Tiberiu en Pexels'}\n  ];\n\n  const MODGROUPS = [\n    {t:'Salsa', type:'radio', req:1, o:[{l:'BBQ',v:0},{l:'Búfalo',v:0},{l:'Mango habanero',v:0},{l:'Limón pimienta',v:0}]},\n    {t:'Aderezo', type:'check', o:[{l:'Ranch',v:15},{l:'Queso azul',v:18}]},\n    {t:'Extras', type:'check', o:[{l:'Extra queso',v:12},{l:'Sin cebolla',v:0},{l:'Doble carne',v:35}]}\n  ];\n\n  const money = n => '$' + n.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2});\n  const $ = s => document.querySelector(s);\n  const $$ = s => Array.from(document.querySelectorAll(s));\n\n  let activeCat = 'top', query = '', lineSeq = 3;\n  let lines = [\n    {k:1, id:'a10', n:'Alitas 10', unit:195, qty:1, mods:[{l:'BBQ',v:0},{l:'Aderezo ranch',v:15}]},\n    {k:2, id:'he', n:'Hamburguesa especial', unit:120, qty:1, mods:[]},\n    {k:3, id:'rf', n:'Refresco', unit:35, qty:2, mods:[]}\n  ];\n\n  /* ---------- CATEGORIES ---------- */\n  function countOf(k){ return P.filter(p => k==='top' ? p.top : p.c===k).length; }\n  function renderCats(){\n    $('#cats').innerHTML = CATS.map(c => {\n      const on = c.k===activeCat;\n      return '<button class=\"catrow w-full h-[52px] px-3.5 flex items-center gap-2.5 text-left '+(on?'bg-[var(--c-ink)] text-white':'text-[var(--c-ink-2)]')+'\" data-cat=\"'+c.k+'\">'\n        + '<i class=\"ti '+c.i+' text-[18px] '+(on?'':'text-[var(--c-muted)]')+'\"></i>'\n        + '<span class=\"text-[13.5px] font-'+(on?'semibold':'medium')+' truncate\">'+c.n+'</span>'\n        + '<span class=\"mono ml-auto text-[12px] '+(on?'text-white/70':'text-[var(--c-muted)]')+'\">'+countOf(c.k)+'</span>'\n        + '</button>';\n    }).join('');\n    $$('#cats [data-cat]').forEach(b => b.onclick = () => { activeCat = b.dataset.cat; query=''; $('#search').value=''; renderCats(); renderGrid(); });\n  }\n\n  /* ---------- PRODUCT GRID ---------- */\n  function visible(){\n    return P.filter(p => (activeCat==='top' ? p.top : p.c===activeCat))\n             .filter(p => p.n.toLowerCase().includes(query.toLowerCase()));\n  }\n  function renderGrid(){\n    const list = query ? P.filter(p=>p.n.toLowerCase().includes(query.toLowerCase())) : visible();\n    $('#catTitle').textContent = query ? 'Resultados de búsqueda' : (CATS.find(c=>c.k===activeCat).n);\n    $('#visCount').textContent = list.length;\n    $('#empty').classList.toggle('hidden', list.length>0);\n    $('#grid').innerHTML = list.map(p =>\n      '<button class=\"pcard group text-left bg-[var(--c-card)] border border-[var(--c-line)] rounded-[6px] overflow-hidden\" data-id=\"'+p.id+'\">'\n      + '<div class=\"pmedia relative h-[124px] bg-[var(--c-line-2)]\">'\n        + '<img src=\"'+PX(p.img,420)+'\" alt=\"'+p.n+' — foto de '+p.by+'\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover\">'\n        + (p.custom ? '<span class=\"absolute top-2 left-2 h-7 px-2 rounded-[4px] bg-white/95 text-[var(--c-ink)] inline-flex items-center gap-1 text-[10px] font-semibold tracking-[0.06em] uppercase\"><i class=\"ti ti-adjustments-horizontal text-[13px]\"></i>Opciones</span>' : '')\n        + '<span class=\"plus opacity-0 absolute top-2 right-2 w-8 h-8 rounded-[4px] bg-[var(--c-accent)] text-white grid place-items-center\"><i class=\"ti ti-plus text-[18px]\"></i></span>'\n      + '</div>'\n      + '<div class=\"pbody px-3 py-2.5\">'\n        + '<p class=\"text-[15px] font-semibold leading-[1.25] line-clamp-2 min-h-[38px]\">'+p.n+'</p>'\n        + '<div class=\"prow mt-1.5 flex items-center gap-2\">'\n          + '<span class=\"mono text-[17px] font-bold\">'+money(p.p)+'</span>'\n          + '<i class=\"ti ti-plus ml-auto text-[16px] text-[var(--c-muted)]\"></i>'\n        + '</div>'\n      + '</div></button>').join('');\n    $$('#grid .pcard').forEach(b => b.onclick = () => {\n      const p = P.find(x => x.id===b.dataset.id);\n      if(p.custom) openMods(p); else addLine(p, 1, []);\n    });\n  }\n\n  /* ---------- TICKET ---------- */\n  function totals(){\n    const total = lines.reduce((s,l)=>s+l.unit*l.qty,0);\n    const sub = total/1.16;\n    return {total, sub, iva: total-sub, qty: lines.reduce((s,l)=>s+l.qty,0)};\n  }\n  function renderLines(){\n    if(!lines.length){\n      $('#lines').innerHTML = '<div class=\"h-full grid place-items-center px-8 text-center\">'\n        + '<div><i class=\"ti ti-receipt-off text-[34px] text-[var(--c-line)]\"></i>'\n        + '<p class=\"mt-2 text-[13.5px] font-semibold\">Pedido vacío</p>'\n        + '<p class=\"text-[12.5px] text-[var(--c-muted)] mt-0.5\">Toca un producto del catálogo para agregarlo.</p></div></div>';\n    } else {\n      $('#lines').innerHTML = lines.map(l =>\n        '<div class=\"px-4 py-2.5 border-b border-[var(--c-line-2)]\">'\n        + '<div class=\"flex items-start gap-2\">'\n          + '<p class=\"text-[14px] font-semibold leading-tight flex-1 min-w-0\">'+l.n+'</p>'\n          + '<span class=\"mono text-[14px] font-semibold\">'+money(l.unit*l.qty)+'</span>'\n          + '<button class=\"w-6 h-6 grid place-items-center rounded-[4px] text-[var(--c-muted)] hover:text-[var(--c-cancelado)] hover:bg-[var(--c-line-2)]\" data-del=\"'+l.k+'\" aria-label=\"Quitar '+l.n+'\"><i class=\"ti ti-trash text-[15px]\"></i></button>'\n        + '</div>'\n        + (l.mods.length ? '<ul class=\"mt-1 ml-0.5 space-y-[1px]\">'+l.mods.map(m=>'<li class=\"text-[12px] text-[var(--c-muted)]\">· '+m.l+(m.v?' <span class=\"mono\">+'+money(m.v)+'</span>':'')+'</li>').join('')+'</ul>' : '')\n        + '<div class=\"mt-1.5 flex items-center gap-2\">'\n          + '<div class=\"flex items-center rounded-[6px] border border-[var(--c-line)] overflow-hidden\">'\n            + '<button class=\"w-11 h-11 grid place-items-center text-[var(--c-ink-2)] hover:bg-[var(--c-line-2)]\" data-minus=\"'+l.k+'\" aria-label=\"Menos\"><i class=\"ti ti-minus text-[17px]\"></i></button>'\n            + '<span class=\"mono w-9 text-center text-[15px] font-bold\">'+l.qty+'</span>'\n            + '<button class=\"w-11 h-11 grid place-items-center text-[var(--c-ink-2)] hover:bg-[var(--c-line-2)]\" data-plus=\"'+l.k+'\" aria-label=\"Más\"><i class=\"ti ti-plus text-[17px]\"></i></button>'\n          + '</div>'\n          + '<span class=\"mono ml-auto text-[12px] text-[var(--c-muted)]\">'+money(l.unit)+' c/u</span>'\n        + '</div></div>').join('');\n    }\n    const t = totals();\n    $('#subtotal').textContent = money(t.sub);\n    $('#iva').textContent = money(t.iva);\n    $('#total').textContent = money(t.total);\n    $('#cobrarTotal').textContent = money(t.total);\n    $('#itemCount').textContent = t.qty;\n    $('#btnCobrar').disabled = !lines.length;\n    $('#btnCobrar').style.opacity = lines.length ? 1 : .4;\n\n    $$('#lines [data-plus]').forEach(b=>b.onclick=()=>{ find(b.dataset.plus).qty++; renderLines(); });\n    $$('#lines [data-minus]').forEach(b=>b.onclick=()=>{ const l=find(b.dataset.minus); l.qty--; if(l.qty<=0) lines=lines.filter(x=>x.k!==l.k); renderLines(); });\n    $$('#lines [data-del]').forEach(b=>b.onclick=()=>{ lines=lines.filter(x=>String(x.k)!==b.dataset.del); renderLines(); });\n  }\n  const find = k => lines.find(l=>String(l.k)===String(k));\n\n  function addLine(p, qty, mods, note){\n    const extra = mods.reduce((s,m)=>s+m.v,0);\n    const unit = p.p + extra;\n    const sig = JSON.stringify(mods.map(m=>m.l))+ (note||'');\n    const same = lines.find(l => l.id===p.id && l.unit===unit && JSON.stringify(l.mods.map(m=>m.l))+(l.note||'')===sig);\n    if(same){ same.qty += qty; }\n    else { lines.push({k:++lineSeq, id:p.id, n:p.n, unit, qty, mods:mods.slice(), note:note||''}); }\n    renderLines();\n    const box = document.getElementById('lines'); box.scrollTop = box.scrollHeight;\n  }\n\n  /* ---------- MODIFIERS MODAL ---------- */\n  let mm = {p:null, qty:1, sel:{}};\n  function openMods(p){\n    mm = {p, qty:1, sel:{0:0}};\n    $('#mmName').textContent = p.n;\n    $('#mmBase').textContent = money(p.p);\n    $('#mmNote').value = '';\n    $('#mmQty').textContent = '1';\n    $('#mmGroups').innerHTML = MODGROUPS.map((g,gi) =>\n      '<div class=\"'+(gi?'mt-5':'')+'\">'\n      + '<div class=\"flex items-baseline gap-2 mb-2\">'\n        + '<p class=\"text-[10px] font-semibold tracking-[0.12em] text-[var(--c-muted)]\">'+g.t.toUpperCase()+'</p>'\n        + '<span class=\"text-[10px] font-semibold tracking-[0.06em] '+(g.req?'text-[var(--c-cancelado)]':'text-[var(--c-muted)]')+'\">'+(g.req?'OBLIGATORIO':'OPCIONAL')+'</span>'\n      + '</div>'\n      + '<div class=\"rounded-[6px] border border-[var(--c-line)] overflow-hidden\">'\n      + g.o.map((o,oi) =>\n        '<button class=\"opt w-full h-11 px-3 flex items-center gap-2.5 text-left '+(oi?'border-t border-[var(--c-line-2)]':'')+' hover:bg-[var(--c-line-2)]\" data-g=\"'+gi+'\" data-o=\"'+oi+'\" data-type=\"'+g.type+'\">'\n        + '<span class=\"ind w-5 h-5 rounded-[4px] border-2 border-[var(--c-line)] grid place-items-center text-white shrink-0\"><i class=\"ti ti-check text-[13px] opacity-0\"></i></span>'\n        + '<span class=\"text-[13.5px] font-medium\">'+o.l+'</span>'\n        + (o.v ? '<span class=\"mono ml-auto text-[13px] font-semibold\">+'+money(o.v)+'</span>' : '<span class=\"ml-auto text-[12px] text-[var(--c-muted)]\">Sin costo</span>')\n        + '</button>').join('')\n      + '</div></div>').join('');\n\n    $$('#mmGroups .opt').forEach(b => b.onclick = () => {\n      const gi = +b.dataset.g, oi = +b.dataset.o;\n      if(b.dataset.type==='radio'){ mm.sel[gi] = oi; }\n      else {\n        mm.sel[gi] = mm.sel[gi] || [];\n        const i = mm.sel[gi].indexOf(oi);\n        if(i>-1) mm.sel[gi].splice(i,1); else mm.sel[gi].push(oi);\n      }\n      paintMods();\n    });\n    paintMods();\n    show('#modMods');\n  }\n  function selectedMods(){\n    const out = [];\n    MODGROUPS.forEach((g,gi)=>{\n      if(g.type==='radio'){ const oi = mm.sel[gi]; if(oi!=null) out.push({l:g.t+': '+g.o[oi].l, v:g.o[oi].v}); }\n      else (mm.sel[gi]||[]).forEach(oi => out.push({l:g.o[oi].l, v:g.o[oi].v}));\n    });\n    return out;\n  }\n  function paintMods(){\n    $$('#mmGroups .opt').forEach(b=>{\n      const gi=+b.dataset.g, oi=+b.dataset.o;\n      const on = b.dataset.type==='radio' ? mm.sel[gi]===oi : (mm.sel[gi]||[]).includes(oi);\n      const ind = b.querySelector('.ind');\n      ind.style.background = on ? 'var(--c-accent)' : 'transparent';\n      ind.style.borderColor = on ? 'var(--c-accent)' : 'var(--c-line)';\n      ind.querySelector('i').style.opacity = on ? 1 : 0;\n      b.style.background = on ? 'rgba(29,78,216,.05)' : '';\n    });\n    const extra = selectedMods().reduce((s,m)=>s+m.v,0);\n    $('#mmTotal').textContent = money((mm.p.p+extra)*mm.qty);\n  }\n  $('#mmPlus').onclick = ()=>{ mm.qty++; $('#mmQty').textContent = mm.qty; paintMods(); };\n  $('#mmMinus').onclick = ()=>{ if(mm.qty>1){ mm.qty--; $('#mmQty').textContent = mm.qty; paintMods(); } };\n  $('#mmAdd').onclick = ()=>{ addLine(mm.p, mm.qty, selectedMods(), $('#mmNote').value.trim()); hide('#modMods'); };\n\n  /* ---------- PAY MODAL ---------- */\n  let pay = {method:'efectivo', digits:''};\n  const recVal = () => pay.digits==='' ? 0 : parseInt(pay.digits,10);\n  function paintPay(){\n    const t = totals().total;\n    $('#payTotal').textContent = money(t);\n    $('#received').textContent = money(recVal());\n    const diff = recVal() - t;\n    const cash = pay.method==='efectivo';\n    $('#change').textContent = money(cash ? Math.max(diff,0) : 0);\n    const box = $('#changeBox'), msg = $('#changeMsg');\n    if(!cash){\n      box.style.borderColor='var(--c-line)'; box.style.background='transparent';\n      msg.textContent='Pago sin efectivo: no aplica cambio'; msg.style.color='var(--c-muted)';\n      $('#change').style.color='var(--c-muted)';\n      $('#payConfirm').disabled=false;\n    } else if(recVal()===0){\n      box.style.borderColor='var(--c-line)'; box.style.background='transparent';\n      msg.textContent='Falta capturar el monto'; msg.style.color='var(--c-muted)';\n      $('#change').style.color='var(--c-ink)';\n      $('#payConfirm').disabled=true;\n    } else if(diff<0){\n      box.style.borderColor='var(--c-cancelado)'; box.style.background='rgba(185,28,28,.05)';\n      msg.textContent='Faltan '+money(-diff); msg.style.color='var(--c-cancelado)';\n      $('#change').style.color='var(--c-cancelado)';\n      $('#payConfirm').disabled=true;\n    } else {\n      box.style.borderColor='var(--c-listo)'; box.style.background='rgba(21,128,61,.05)';\n      msg.textContent='Monto suficiente'; msg.style.color='var(--c-listo)';\n      $('#change').style.color='var(--c-listo)';\n      $('#payConfirm').disabled=false;\n    }\n    $('#payConfirm').style.opacity = $('#payConfirm').disabled ? .4 : 1;\n  }\n  $$('#methods .mbtn').forEach(b => b.onclick = ()=>{\n    pay.method = b.dataset.m;\n    $$('#methods .mbtn').forEach(x=>{\n      const on = x===b;\n      x.className = 'mbtn h-[86px] rounded-[6px] grid place-items-center gap-1 content-center '\n        + (on ? 'border-2 border-[var(--c-ink)] bg-[var(--c-ink)] text-white' : 'border border-[var(--c-line)] text-[var(--c-ink-2)] hover:border-[var(--c-accent)]');\n    });\n    $('#payHint').textContent = pay.method==='efectivo' ? 'Captura con el teclado' : 'Confirma el monto exacto';\n    paintPay();\n  });\n  $$('.kpad button').forEach(b => b.onclick = ()=>{\n    const k = b.dataset.k;\n    if(k==='del') pay.digits = pay.digits.slice(0,-1);\n    else if(pay.digits.length < 7) pay.digits = (pay.digits==='0'?'':pay.digits) + k;\n    paintPay();\n  });\n  $$('.quick').forEach(b => b.onclick = ()=>{\n    pay.digits = b.dataset.q==='exact' ? String(Math.round(totals().total)) : b.dataset.q;\n    paintPay();\n  });\n  $('#btnCobrar').onclick = ()=>{\n    if(!lines.length) return;\n    pay = {method:'efectivo', digits:''};\n    $$('#methods .mbtn')[0].click();\n    $('#payBody').classList.remove('hidden');\n    $('#paySuccess').classList.add('hidden');\n    paintPay();\n    show('#modPay');\n  };\n  $('#payConfirm').onclick = ()=>{\n    const t = totals().total, diff = recVal()-t;\n    $('#okTotal').textContent = money(t);\n    $('#okMethod').textContent = {efectivo:'Efectivo',tarjeta:'Tarjeta',transferencia:'Transferencia',qr:'QR'}[pay.method];\n    $('#okChange').textContent = money(pay.method==='efectivo' ? Math.max(diff,0) : 0);\n    $('#payBody').classList.add('hidden');\n    $('#paySuccess').classList.remove('hidden');\n  };\n\n  /* ---------- MODAL PLUMBING ---------- */\n  function show(s){ $(s).classList.remove('hidden'); }\n  function hide(s){ $(s).classList.add('hidden'); }\n  $$('[data-close]').forEach(el => el.onclick = ()=>{ hide('#modMods'); hide('#modPay'); });\n  document.addEventListener('keydown', e => {\n    if(e.key==='Escape'){ hide('#modMods'); hide('#modPay'); }\n    if(e.key==='F2'){ e.preventDefault(); $('#search').focus(); }\n  });\n\n  /* ---------- SEARCH + VIEW ---------- */\n  $('#search').addEventListener('input', e => { query = e.target.value; renderGrid(); });\n  $('#viewGrid').onclick = ()=>{\n    $('#center').classList.remove('listview');\n    $('#viewGrid').className = 'w-11 h-11 grid place-items-center bg-[var(--c-ink)] text-white';\n    $('#viewList').className = 'w-11 h-11 grid place-items-center text-[var(--c-ink-2)] border-l border-[var(--c-line)]';\n  };\n  $('#viewList').onclick = ()=>{\n    $('#center').classList.add('listview');\n    $('#viewList').className = 'w-11 h-11 grid place-items-center bg-[var(--c-ink)] text-white border-l border-[var(--c-line)]';\n    $('#viewGrid').className = 'w-11 h-11 grid place-items-center text-[var(--c-ink-2)]';\n  };\n\n  /* ---------- STATE-REPORTING TIMER ---------- */\n  let secs = 41;\n  setInterval(()=>{\n    secs++;\n    const m = String(Math.floor(secs/60)).padStart(2,'0'), s = String(secs%60).padStart(2,'0');\n    $('#timer').textContent = m+':'+s;\n  },1000);\n\n  renderCats(); renderGrid(); renderLines();\n})();\n</script>\n",
      "comments": [],
      "created": "2026-08-18T00:44:08.969910+00:00",
      "modified": "2026-08-18T00:47:48.055103+00:00",
      "id": "var_c91a1c3e0a9e"
    },
    "var_c9bacbd2e74d": {
      "type": "variant",
      "label": "POS · B · Precisión clínica",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root{\n  --c-page:#F7F8FA;\n  --c-card:#FFFFFF;\n  --c-ink:#10131A;\n  --c-muted:#56607A;\n  --c-line:#E3E6EC;\n  --c-line-strong:#C3C8D4;\n  --c-accent:#4338CA;\n  --c-nuevo:#4338CA;\n  --c-preparando:#A16207;\n  --c-listo:#157347;\n  --c-porcobrar:#475569;\n  --c-cancelado:#B42318;\n}\n.pos-root{font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}\n.mono{font-family:'Roboto Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;}\n.pos-root :focus-visible{outline:2px solid var(--c-accent);outline-offset:2px;}\n.lbl{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--c-muted);}\n.leader{flex:1 1 auto;border-bottom:1px dotted var(--c-line-strong);transform:translateY(-4px);min-width:12px;}\n.dashrule{height:1px;background-image:linear-gradient(to right,var(--c-line-strong) 0 6px,transparent 6px 12px);background-size:12px 1px;background-repeat:repeat-x;}\n.zig{position:absolute;left:0;right:0;height:7px;\n  background-image:linear-gradient(45deg,transparent 50%,#fff 50%),linear-gradient(-45deg,transparent 50%,#fff 50%);\n  background-size:12px 14px;background-repeat:repeat-x;}\n.zig-top{top:-7px;background-position:bottom;transform:scaleY(-1);}\n.zig-bottom{bottom:-7px;}\n.scroll-thin{scrollbar-width:thin;scrollbar-color:var(--c-line-strong) transparent;}\n.scroll-thin::-webkit-scrollbar{width:8px;height:8px;}\n.scroll-thin::-webkit-scrollbar-thumb{background:var(--c-line-strong);border-radius:4px;}\n.scroll-thin::-webkit-scrollbar-track{background:transparent;}\n.navitem{border-left:2px solid transparent;}\n.navitem:hover{background:var(--c-page);}\n.navitem.is-active{border-left-color:var(--c-accent);color:var(--c-ink);font-weight:600;}\n.prodbtn:hover{background:var(--c-card);border-color:var(--c-accent);}\n.prodbtn:active{transform:translateY(1px);}\n.optrow{border:1px solid var(--c-line);}\n.optrow:hover{border-color:var(--c-line-strong);background:var(--c-page);}\n.optrow.is-on{border-color:var(--c-accent);background:#fff;}\n.optbox{width:18px;height:18px;border:1px solid var(--c-line-strong);border-radius:2px;display:flex;align-items:center;justify-content:center;flex:none;}\n.optrow.is-on .optbox{border-color:var(--c-accent);background:var(--c-accent);color:#fff;}\n.key:active{background:var(--c-page);}\n.paper{box-shadow:0 1px 2px rgba(16,19,26,.05),0 18px 40px -18px rgba(16,19,26,.22);}\n</style>\n<div class=\"pos-root h-[940px] w-full flex bg-[var(--c-page)] text-[15px] text-[var(--c-ink)] antialiased\" data-kid=\"1\">\n    <!-- ══════════ SIDEBAR ══════════ -->\n    <aside class=\"w-[240px] flex-none bg-[var(--c-card)] border-r border-[var(--c-line)] flex flex-col\" data-kid=\"1-1\">\n        <div class=\"h-[60px] flex items-center gap-2.5 px-5 border-b border-[var(--c-line)]\" data-kid=\"1-1-1\">\n            <span class=\"w-5 h-5 rounded-[3px] bg-[var(--c-accent)] flex-none\" data-kid=\"1-1-1-1\">\n            </span>\n            <span class=\"text-[15px] font-bold tracking-tight\" data-kid=\"1-1-1-2\">\n                POSTIA\n            </span>\n            <span class=\"mono ml-auto text-[11px] text-[var(--c-muted)]\" data-kid=\"1-1-1-3\" data-name=\"version number label\">\n                v1.0\n            </span>\n        </div>\n        <nav class=\"flex-1 overflow-y-auto scroll-thin py-4\" data-kid=\"1-1-2\">\n            <p class=\"lbl px-5 pb-1.5\" data-kid=\"1-1-2-1\">\n                Operación\n            </p>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-2\">\n                <i class=\"ti ti-home text-[19px]\" data-kid=\"1-1-2-2-1\">\n                </i>\n                Inicio\n            </button>\n            <button class=\"navitem is-active w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-3\">\n                <i class=\"ti ti-receipt text-[19px]\" data-kid=\"1-1-2-3-1\">\n                </i>\n                Pedidos\n                <span class=\"mono ml-auto text-[12px] text-[var(--c-muted)] font-normal\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2\" data-name=\"pedido counter\" data-reason=\"text updated when order list changes\">\n                    7\n                </span>\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-4\">\n                <i class=\"ti ti-chef-hat text-[19px]\" data-kid=\"1-1-2-4-1\">\n                </i>\n                Cocina\n                <span class=\"mono ml-auto text-[12px]\" data-dynamic=\"true\" data-kid=\"1-1-2-4-2\" data-name=\"cocina item counter\" data-reason=\"text updated when kitchen item count changes\">\n                    3\n                </span>\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-5\">\n                <i class=\"ti ti-layout-grid text-[19px]\" data-kid=\"1-1-2-5-1\">\n                </i>\n                Mesas\n                <span class=\"mono ml-auto text-[12px]\" data-dynamic=\"true\" data-kid=\"1-1-2-5-2\" data-name=\"mesas counter\" data-reason=\"text updated when table occupancy changes\">\n                    5/12\n                </span>\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-6\">\n                <i class=\"ti ti-cash text-[19px]\" data-kid=\"1-1-2-6-1\">\n                </i>\n                Caja\n            </button>\n            <p class=\"lbl px-5 pt-5 pb-1.5\" data-kid=\"1-1-2-7\">\n                Catálogo\n            </p>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-8\">\n                <i class=\"ti ti-package text-[19px]\" data-kid=\"1-1-2-8-1\">\n                </i>\n                Productos\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-9\">\n                <i class=\"ti ti-tag text-[19px]\" data-kid=\"1-1-2-9-1\">\n                </i>\n                Categorías\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-10\">\n                <i class=\"ti ti-adjustments text-[19px]\" data-kid=\"1-1-2-10-1\">\n                </i>\n                Modificadores\n            </button>\n            <p class=\"lbl px-5 pt-5 pb-1.5\" data-kid=\"1-1-2-11\">\n                Reportes\n            </p>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-12\">\n                <i class=\"ti ti-history text-[19px]\" data-kid=\"1-1-2-12-1\">\n                </i>\n                Historial\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-13\">\n                <i class=\"ti ti-chart-bar text-[19px]\" data-kid=\"1-1-2-13-1\">\n                </i>\n                Reportes\n            </button>\n            <p class=\"lbl px-5 pt-5 pb-1.5\" data-kid=\"1-1-2-14\">\n                Administración\n            </p>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-15\">\n                <i class=\"ti ti-users text-[19px]\" data-kid=\"1-1-2-15-1\">\n                </i>\n                Clientes\n            </button>\n            <button class=\"navitem w-full h-[48px] flex items-center gap-3 pl-[18px] pr-5 text-left text-[15px] text-[var(--c-muted)]\" data-kid=\"1-1-2-16\">\n                <i class=\"ti ti-id-badge-2 text-[19px]\" data-kid=\"1-1-2-16-1\">\n                </i>\n                Equipo\n            </button>\n        </nav>\n        <div class=\"border-t border-[var(--c-line)] px-5 py-4\" data-kid=\"1-1-3\">\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-1\">\n                <span class=\"w-2 h-2 rounded-full bg-[var(--c-accent)] flex-none\" data-kid=\"1-1-3-1-1\">\n                </span>\n                <span class=\"text-[13px] font-semibold\" data-kid=\"1-1-3-1-2\">\n                    Caja abierta\n                </span>\n            </div>\n            <p class=\"mt-1 text-[13px] text-[var(--c-muted)]\" data-kid=\"1-1-3-2\">\n                Fondo\n                <span class=\"mono font-medium text-[var(--c-ink)]\" data-dynamic=\"true\" data-kid=\"1-1-3-2-1\" data-name=\"fondo de caja amount\" data-reason=\"value initialized and updated by system\">\n                    $1,000.00\n                </span>\n            </p>\n        </div>\n    </aside>\n    <!-- ══════════ MAIN ══════════ -->\n    <div class=\"flex-1 min-w-0 flex flex-col\" data-kid=\"1-2\">\n        <!-- Topbar -->\n        <header class=\"h-[60px] flex-none bg-[var(--c-card)] border-b border-[var(--c-line)] flex items-center pl-6 pr-2\" data-kid=\"1-2-1\">\n            <div class=\"min-w-0\" data-kid=\"1-2-1-1\">\n                <h1 class=\"text-[20px] font-semibold leading-none\" data-kid=\"1-2-1-1-1\">\n                    Nuevo pedido\n                </h1>\n                <p class=\"mt-1 text-[13px] text-[var(--c-muted)] leading-none\" data-kid=\"1-2-1-1-2\">\n                    Mostrador · folio\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1\" data-name=\"folio code\" data-reason=\"folio value injected by script\">\n                        A-1043\n                    </span>\n                </p>\n            </div>\n            <div class=\"ml-auto flex items-stretch h-full\" data-kid=\"1-2-1-2\">\n                <div class=\"flex items-center gap-2 px-5 border-l border-[var(--c-line)] text-[13px] text-[var(--c-muted)]\" data-kid=\"1-2-1-2-1\">\n                    <i class=\"ti ti-clock text-[17px]\" data-kid=\"1-2-1-2-1-1\">\n                    </i>\n                    <span class=\"mono text-[var(--c-ink)] font-medium\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2\" data-name=\"current time display\" data-reason=\"time updated periodically by script\">\n                        18:42\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 px-5 border-l border-[var(--c-line)] text-[13px] text-[var(--c-muted)]\" data-kid=\"1-2-1-2-2\">\n                    Turno\n                    <span class=\"mono text-[var(--c-ink)] font-medium\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1\" data-name=\"turno duration display\" data-reason=\"duration updated periodically by script\">\n                        4h 12m\n                    </span>\n                </div>\n                <button class=\"flex items-center px-4 border-l border-[var(--c-line)] text-[var(--c-muted)] hover:text-[var(--c-ink)]\" data-kid=\"1-2-1-2-3\">\n                    <i class=\"ti ti-bell text-[19px]\" data-kid=\"1-2-1-2-3-1\">\n                    </i>\n                </button>\n                <div class=\"flex items-center gap-2.5 pl-5 pr-4 border-l border-[var(--c-line)]\" data-kid=\"1-2-1-2-4\">\n                    <span class=\"w-8 h-8 rounded-[3px] bg-[var(--c-ink)] text-white text-