      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap');\n\n#app{\n  --c-page:#E9EDF2;\n  --c-card:#FFFFFF;\n  --c-ink:#0A0F1A;\n  --c-muted:#4E5A6E;\n  --c-line:#0A0F1A;\n  --c-line-soft:#C9D2DD;\n  --c-brand:#1B4FD8;\n  --c-nuevo:#1B4FD8;\n  --c-preparando:#C77700;\n  --c-listo:#0F7A3D;\n  --c-cobrar:#3D4A5C;\n  --c-cancelado:#C42121;\n  font-family:'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;\n  font-weight:500;\n  background:var(--c-page);\n  color:var(--c-ink);\n  -webkit-font-smoothing:antialiased;\n}\n#app .tnum{font-variant-numeric:tabular-nums;font-weight:800}\n#app .lbl{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}\n#app :focus-visible{outline:3px solid var(--c-brand);outline-offset:2px}\n#app .press{transition:transform .06s linear, box-shadow .06s linear}\n#app .press:active{transform:translate(2px,2px)}\n#app .tile:active{transform:translate(2px,2px)}\n#app .scroll{scrollbar-width:thin;scrollbar-color:var(--c-line-soft) transparent}\n#app .scroll::-webkit-scrollbar{width:10px}\n#app .scroll::-webkit-scrollbar-thumb{background:var(--c-line-soft);border:2px solid var(--c-page)}\n#app .navbtn[data-active=\"true\"]{background:var(--c-brand);color:#fff}\n#app .catbtn[data-active=\"true\"]{background:#fff;color:var(--c-ink)}\n#app .optbtn[data-on=\"true\"]{background:var(--c-ink);color:#fff;border-color:var(--c-ink)}\n#app .paybtn[data-on=\"true\"]{background:var(--c-brand);color:#fff;border-color:var(--c-brand)}\n#app kbd{font-family:inherit;font-weight:800;font-size:11px;border:2px solid var(--c-line-soft);padding:2px 6px;border-radius:4px;color:var(--c-muted)}\n#app .ok-pop{animation:okpop .28s ease-out both}\n@keyframes okpop{from{transform:scale(.86);opacity:0}to{transform:scale(1);opacity:1}}\n</style>\n<div class=\"w-full overflow-hidden select-none\" data-kid=\"2\" id=\"app\" style=\"height:920px\">\n    <!-- ================= TOPBAR ================= -->\n    <header class=\"flex items-stretch justify-between bg-[var(--c-ink)] text-white\" data-kid=\"2-1\" style=\"height:64px\">\n        <div class=\"flex items-stretch\" data-kid=\"2-1-1\">\n            <div class=\"flex items-center gap-3 px-6\" data-kid=\"2-1-1-1\">\n                <span class=\"grid place-items-center bg-[var(--c-brand)]\" data-kid=\"2-1-1-1-1\" style=\"width:32px;height:32px;border-radius:6px\">\n                    <i class=\"ti ti-bolt text-[20px]\" data-kid=\"2-1-1-1-1-1\">\n                    </i>\n                </span>\n                <span data-kid=\"2-1-1-1-2\" style=\"font-size:18px;font-weight:800;letter-spacing:.04em\">\n                    POSTIA\n                </span>\n            </div>\n            <div class=\"flex items-center px-6 border-l-2 border-white/20\" data-kid=\"2-1-1-2\">\n                <span class=\"lbl text-white/60\" data-kid=\"2-1-1-2-1\">\n                    Pedidos /\n                    <span class=\"text-white\" data-kid=\"2-1-1-2-1-1\">\n                        Nuevo\n                    </span>\n                </span>\n            </div>\n        </div>\n        <div class=\"flex items-stretch\" data-kid=\"2-1-2\">\n            <div class=\"flex items-center gap-2 px-5 border-l-2 border-white/20\" data-kid=\"2-1-2-1\">\n                <i class=\"ti ti-table text-[22px] text-white/70\" data-kid=\"2-1-2-1-1\">\n                </i>\n                <span class=\"lbl\" data-kid=\"2-1-2-1-2\">\n                    Mesa libre\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2 px-5 border-l-2 border-white/20\" data-kid=\"2-1-2-2\">\n                <i class=\"ti ti-clock text-[22px] text-white/70\" data-kid=\"2-1-2-2-1\">\n                </i>\n                <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-1-2-2-2\" data-name=\"current time\" data-reason=\"text updated every second by script\" style=\"font-size:16px\">\n                    18:42\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2 px-5 border-l-2 border-white/20\" data-kid=\"2-1-2-3\">\n                <span class=\"lbl text-white/60\" data-kid=\"2-1-2-3-1\">\n                    Turno\n                </span>\n                <span class=\"tnum\" data-kid=\"2-1-2-3-2\" style=\"font-size:16px\">\n                    4h 12m\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3 px-5 border-l-2 border-white/20\" data-kid=\"2-1-2-4\">\n                <span class=\"grid place-items-center bg-white text-[var(--c-ink)]\" data-kid=\"2-1-2-4-1\" style=\"width:32px;height:32px;border-radius:6px;font-weight:800;font-size:13px\">\n                    AD\n                </span>\n                <span class=\"lbl\" data-kid=\"2-1-2-4-2\">\n                    Administrador\n                </span>\n            </div>\n        </div>\n    </header>\n    <div class=\"flex items-stretch\" data-kid=\"2-2\" style=\"height:772px\">\n        <!-- ================= NAV RAIL ================= -->\n        <nav class=\"shrink-0 bg-[var(--c-card)] border-r-2 border-[var(--c-line)] flex flex-col items-center gap-1 py-3\" data-kid=\"2-2-1\" style=\"width:72px\">\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-1\" data-name=\"navigation button home\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-home text-[24px] block text-center\" data-kid=\"2-2-1-1-1\">\n                </i>\n                <span data-kid=\"2-2-1-1-2\" style=\"font-size:10px;font-weight:800\">\n                    INICIO\n                </span>\n            </button>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"true\" data-kid=\"2-2-1-2\" data-name=\"navigation button orders\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-receipt text-[24px] block text-center\" data-kid=\"2-2-1-2-1\">\n                </i>\n                <span data-kid=\"2-2-1-2-2\" style=\"font-size:10px;font-weight:800\">\n                    PEDIDOS\n                </span>\n            </button>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-3\" data-name=\"navigation button kitchen\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-tools-kitchen-2 text-[24px] block text-center\" data-kid=\"2-2-1-3-1\">\n                </i>\n                <span data-kid=\"2-2-1-3-2\" style=\"font-size:10px;font-weight:800\">\n                    COCINA\n                </span>\n            </button>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-4\" data-name=\"navigation button tables\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-layout-grid text-[24px] block text-center\" data-kid=\"2-2-1-4-1\">\n                </i>\n                <span data-kid=\"2-2-1-4-2\" style=\"font-size:10px;font-weight:800\">\n                    MESAS\n                </span>\n            </button>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-5\" data-name=\"navigation button register\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-cash text-[24px] block text-center\" data-kid=\"2-2-1-5-1\">\n                </i>\n                <span data-kid=\"2-2-1-5-2\" style=\"font-size:10px;font-weight:800\">\n                    CAJA\n                </span>\n            </button>\n            <div class=\"my-1 bg-[var(--c-line-soft)]\" data-kid=\"2-2-1-6\" style=\"width:40px;height:2px\">\n            </div>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-7\" data-name=\"navigation button products\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-package text-[24px] block text-center\" data-kid=\"2-2-1-7-1\">\n                </i>\n                <span data-kid=\"2-2-1-7-2\" style=\"font-size:10px;font-weight:800\">\n                    PROD.\n                </span>\n            </button>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-8\" data-name=\"navigation button reports\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-chart-bar text-[24px] block text-center\" data-kid=\"2-2-1-8-1\">\n                </i>\n                <span data-kid=\"2-2-1-8-2\" style=\"font-size:10px;font-weight:800\">\n                    REPOR.\n                </span>\n            </button>\n            <button class=\"navbtn press grid place-content-center gap-1\" data-active=\"false\" data-kid=\"2-2-1-9\" data-name=\"navigation button config\" style=\"width:56px;height:56px;border-radius:6px\">\n                <i class=\"ti ti-settings text-[24px] block text-center\" data-kid=\"2-2-1-9-1\">\n                </i>\n                <span data-kid=\"2-2-1-9-2\" style=\"font-size:10px;font-weight:800\">\n                    CONFIG\n                </span>\n            </button>\n            <div class=\"mt-auto grid place-items-center\" data-kid=\"2-2-1-10\" style=\"width:56px\">\n                <span class=\"bg-[var(--c-listo)]\" data-kid=\"2-2-1-10-1\" style=\"width:12px;height:12px;border-radius:3px\">\n                </span>\n                <span class=\"mt-1 text-center\" data-kid=\"2-2-1-10-2\" style=\"font-size:9px;font-weight:800;color:var(--c-listo)\">\n                    CAJA\n                    <br data-kid=\"2-2-1-10-2-1\"/>\n                    ABIERTA\n                </span>\n            </div>\n        </nav>\n        <!-- ================= TICKET (IZQUIERDA) ================= -->\n        <section class=\"shrink-0 bg-[var(--c-card)] border-r-2 border-[var(--c-line)] flex flex-col\" data-kid=\"2-2-2\" style=\"width:420px\">\n            <!-- cabecera bloque de estado -->\n            <div class=\"bg-[var(--c-nuevo)] text-white px-5 py-3 flex items-center justify-between\" data-kid=\"2-2-2-1\">\n                <div data-kid=\"2-2-2-1-1\">\n                    <div class=\"tnum\" data-kid=\"2-2-2-1-1-1\" data-name=\"ticket identification number\" style=\"font-size:22px\">\n                        #A-1043\n                    </div>\n                    <div class=\"lbl text-white/80\" data-kid=\"2-2-2-1-1-2\">\n                        Nuevo\n                    </div>\n                </div>\n                <div class=\"text-right\" data-kid=\"2-2-2-1-2\">\n                    <div class=\"lbl text-white/70\" data-kid=\"2-2-2-1-2-1\">\n                        Transcurrido\n                    </div>\n                    <div class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-2\" data-name=\"elapsed time counter\" data-reason=\"text updated every second by script\" id=\"chrono\" style=\"font-size:22px\">\n                        00:41\n                    </div>\n                </div>\n            </div>\n            <!-- servicio -->\n            <div class=\"flex items-stretch border-b-2 border-[var(--c-line)]\" data-kid=\"2-2-2-2\">\n                <div class=\"flex items-center gap-3 px-5 flex-1\" data-kid=\"2-2-2-2-1\" style=\"height:60px\">\n                    <i class=\"ti ti-building-store text-[24px]\" data-kid=\"2-2-2-2-1-1\">\n                    </i>\n                    <span class=\"lbl\" data-kid=\"2-2-2-2-1-2\">\n                        Mostrador\n                    </span>\n                </div>\n                <button class=\"press border-l-2 border-[var(--c-line)] px-5 lbl\" data-kid=\"2-2-2-2-2\" style=\"height:60px\">\n                    Cambiar\n                </button>\n            </div>\n            <!-- cliente -->\n            <div class=\"flex items-stretch border-b-2 border-[var(--c-line)]\" data-kid=\"2-2-2-3\">\n                <div class=\"flex items-center gap-3 px-5 flex-1\" data-kid=\"2-2-2-3-1\" style=\"height:60px\">\n                    <i class=\"ti ti-user text-[24px] text-[var(--c-muted)]\" data-kid=\"2-2-2-3-1-1\">\n                    </i>\n                    <span class=\"lbl\" data-kid=\"2-2-2-3-1-2\" style=\"color:var(--c-muted)\">\n                        Sin cliente\n                    </span>\n                </div>\n                <button class=\"press border-l-2 border-[var(--c-line)] px-5 lbl\" data-kid=\"2-2-2-3-2\" style=\"height:60px\">\n                    Asignar\n                </button>\n            </div>\n            <!-- lista -->\n            <div class=\"flex-1 overflow-y-auto scroll\" data-dynamic=\"true\" data-kid=\"2-2-2-4\" data-name=\"ticket items list container\" data-reason=\"content dynamically rendered by script\" id=\"ticketList\">\n            </div>\n            <!-- totales -->\n            <div class=\"border-t-2 border-[var(--c-line)] bg-[var(--c-page)] px-5 py-4\" data-kid=\"2-2-2-5\">\n                <div class=\"flex items-center justify-between\" data-kid=\"2-2-2-5-1\" style=\"font-size:14px;font-weight:700;color:var(--c-muted)\">\n                    <span class=\"lbl\" data-kid=\"2-2-2-5-1-1\">\n                        Artículos\n                    </span>\n                    <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-2-5-1-2\" data-name=\"ticket total count\" data-reason=\"number updated by script based on orders\" id=\"tCount\" style=\"font-size:16px;color:var(--c-ink)\">\n                        0\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between mt-2\" data-kid=\"2-2-2-5-2\" style=\"font-size:14px;font-weight:700;color:var(--c-muted)\">\n                    <span class=\"lbl\" data-kid=\"2-2-2-5-2-1\">\n                        Subtotal\n                    </span>\n                    <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-2-5-2-2\" data-name=\"ticket subtotal amount\" data-reason=\"amount updated by script based on orders\" id=\"tSub\" style=\"font-size:16px;color:var(--c-ink)\">\n                        $0.00\n                    </span>\n                </div>\n                <div class=\"flex items-center justify-between mt-2\" data-kid=\"2-2-2-5-3\" style=\"font-size:14px;font-weight:700;color:var(--c-muted)\">\n                    <span class=\"lbl\" data-kid=\"2-2-2-5-3-1\">\n                        IVA incluido\n                    </span>\n                    <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-2-5-3-2\" data-name=\"ticket tax amount\" data-reason=\"amount updated by script based on orders\" id=\"tIva\" style=\"font-size:16px;color:var(--c-ink)\">\n                        $0.00\n                    </span>\n                </div>\n                <div class=\"flex items-end justify-between mt-3 pt-3 border-t-2 border-[var(--c-line-soft)]\" data-kid=\"2-2-2-5-4\">\n                    <span class=\"lbl\" data-kid=\"2-2-2-5-4-1\">\n                        Total\n                    </span>\n                    <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-2-5-4-2\" data-name=\"ticket total amount\" data-reason=\"amount updated by script based on orders\" id=\"tTotal\" style=\"font-size:44px;line-height:1\">\n                        $0.00\n                    </span>\n                </div>\n            </div>\n            <!-- acciones -->\n            <button class=\"press w-full bg-[var(--c-brand)] text-white flex items-center justify-center gap-3 disabled:opacity-40\" data-dynamic=\"true\" data-kid=\"2-2-2-6\" data-name=\"cobrar button\" data-reason=\"disabled state and text amount updated by script\" disabled=\"\" id=\"btnCobrar\" style=\"height:76px;font-size:20px;font-weight:800\">\n                <i class=\"ti ti-cash-register text-[26px]\" data-kid=\"2-2-2-6-1\">\n                </i>\n                <span data-kid=\"2-2-2-6-2\">\n                    COBRAR\n                </span>\n                <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-2-6-3\" data-name=\"cobrar button amount\" data-reason=\"amount text injected by script\" id=\"cobrarAmt\">\n                </span>\n            </button>\n            <div class=\"grid grid-cols-2 gap-0 border-t-2 border-[var(--c-line)]\" data-kid=\"2-2-2-7\">\n                <button class=\"press flex items-center justify-center gap-2 border-r-2 border-[var(--c-line)]\" data-kid=\"2-2-2-7-1\" style=\"height:60px;font-size:13px;font-weight:800\">\n                    <i class=\"ti ti-send text-[22px]\" data-kid=\"2-2-2-7-1-1\">\n                    </i>\n                    A COCINA\n                </button>\n                <button class=\"press flex items-center justify-center gap-2\" data-kid=\"2-2-2-7-2\" style=\"height:60px;font-size:13px;font-weight:800\">\n                    <i class=\"ti ti-device-floppy text-[22px]\" data-kid=\"2-2-2-7-2-1\">\n                    </i>\n                    GUARDAR\n                </button>\n            </div>\n        </section>\n        <!-- ================= CATÁLOGO ================= -->\n        <section class=\"flex-1 flex flex-col min-w-0\" data-kid=\"2-2-3\">\n            <div class=\"flex items-center gap-3 px-5 border-b-2 border-[var(--c-line)] bg-[var(--c-card)]\" data-kid=\"2-2-3-1\" style=\"height:76px\">\n                <div class=\"flex items-center gap-3 flex-1 bg-[var(--c-page)] border-2 border-[var(--c-line)] px-4\" data-kid=\"2-2-3-1-1\" style=\"height:56px;border-radius:6px\">\n                    <i class=\"ti ti-search text-[24px] text-[var(--c-muted)]\" data-kid=\"2-2-3-1-1-1\">\n                    </i>\n                    <input class=\"flex-1 bg-transparent outline-none placeholder:text-[var(--c-muted)]\" data-kid=\"2-2-3-1-1-2\" id=\"search\" placeholder=\"BUSCAR PRODUCTO\" style=\"font-size:16px;font-weight:700;letter-spacing:.02em\" type=\"text\"/>\n                    <kbd data-kid=\"2-2-3-1-1-3\">\n                        F2\n                    </kbd>\n                </div>\n                <div class=\"flex items-center gap-2 border-2 border-[var(--c-line)] px-4\" data-kid=\"2-2-3-1-2\" style=\"height:56px;border-radius:6px\">\n                    <span class=\"lbl\" data-kid=\"2-2-3-1-2-1\" style=\"color:var(--c-muted)\">\n                        En vista\n                    </span>\n                    <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-2-3-1-2-2\" data-name=\"grid count\" data-reason=\"count updated by script based on visible products\" id=\"gridCount\" style=\"font-size:20px\">\n                        4\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex-1 overflow-y-auto scroll grid grid-cols-4 gap-4 p-5 content-start\" data-dynamic=\"true\" data-kid=\"2-2-3-2\" data-name=\"product grid container\" data-reason=\"content dynamically rendered by script\" id=\"grid\">\n            </div>\n        </section>\n    </div>\n    <!-- ================= BARRA DE CATEGORÍAS ================= -->\n    <div class=\"flex items-stretch bg-[var(--c-ink)] border-t-2 border-[var(--c-line)]\" data-dynamic=\"true\" data-kid=\"2-3\" data-name=\"categories bar\" data-reason=\"buttons dynamically injected by script\" id=\"cats\" style=\"height:84px\">\n    </div>\n    <!-- ================= MODAL MODIFICADORES ================= -->\n    <div class=\"hidden fixed inset-0 z-40 items-center justify-center p-6\" data-kid=\"2-4\" id=\"modOverlay\" style=\"background:rgba(10,15,26,.7)\">\n        <div class=\"bg-[var(--c-card)] border-2 border-[var(--c-line)] w-full flex flex-col\" data-kid=\"2-4-1\" style=\"max-width:720px;border-radius:6px;max-height:860px\">\n            <div class=\"flex items-start justify-between px-6 py-4 border-b-2 border-[var(--c-line)]\" data-kid=\"2-4-1-1\">\n                <div data-kid=\"2-4-1-1-1\">\n                    <div class=\"lbl\" data-kid=\"2-4-1-1-1-1\" style=\"color:var(--c-muted)\">\n                        Personalizar\n                    </div>\n                    <div data-kid=\"2-4-1-1-1-2\" id=\"modTitle\" style=\"font-size:26px;font-weight:800;line-height:1.15\">\n                        Alitas 10\n                    </div>\n                </div>\n                <button class=\"press grid place-items-center border-2 border-[var(--c-line)]\" data-kid=\"2-4-1-1-2\" data-name=\"modal close button\" id=\"modClose\" style=\"width:56px;height:56px;border-radius:6px\">\n                    <i class=\"ti ti-x text-[26px]\" data-kid=\"2-4-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"overflow-y-auto scroll px-6 py-5 flex flex-col gap-6\" data-dynamic=\"true\" data-kid=\"2-4-1-2\" data-name=\"modifiers body container\" data-reason=\"content dynamically rendered by script\" id=\"modBody\">\n            </div>\n            <div class=\"border-t-2 border-[var(--c-line)] px-6 py-4 flex items-center gap-4\" data-kid=\"2-4-1-3\">\n                <div class=\"flex items-stretch border-2 border-[var(--c-line)]\" data-kid=\"2-4-1-3-1\" style=\"border-radius:6px\">\n                    <button class=\"press grid place-items-center border-r-2 border-[var(--c-line)]\" data-kid=\"2-4-1-3-1-1\" id=\"modMinus\" style=\"width:64px;height:64px\">\n                        <i class=\"ti ti-minus text-[26px]\" data-kid=\"2-4-1-3-1-1-1\">\n                        </i>\n                    </button>\n                    <div class=\"grid place-items-center tnum\" data-dynamic=\"true\" data-kid=\"2-4-1-3-1-2\" data-name=\"modifier quantity\" data-reason=\"number updated by script\" id=\"modQty\" style=\"width:72px;font-size:26px\">\n                        1\n                    </div>\n                    <button class=\"press grid place-items-center border-l-2 border-[var(--c-line)]\" data-kid=\"2-4-1-3-1-3\" id=\"modPlus\" style=\"width:64px;height:64px\">\n                        <i class=\"ti ti-plus text-[26px]\" data-kid=\"2-4-1-3-1-3-1\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"ml-auto text-right\" data-kid=\"2-4-1-3-2\">\n                    <div class=\"lbl\" data-kid=\"2-4-1-3-2-1\" style=\"color:var(--c-muted)\">\n                        Importe\n                    </div>\n                    <div class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-4-1-3-2-2\" data-name=\"modifier price\" data-reason=\"price updated by script\" id=\"modPrice\" style=\"font-size:34px;line-height:1\">\n                        $180.00\n                    </div>\n                </div>\n            </div>\n            <button class=\"press w-full bg-[var(--c-brand)] text-white\" data-kid=\"2-4-1-4\" data-name=\"modal add to order button\" id=\"modAdd\" style=\"height:72px;font-size:18px;font-weight:800\">\n                AGREGAR AL PEDIDO\n            </button>\n        </div>\n    </div>\n    <!-- ================= MODAL PAGO ================= -->\n    <div class=\"hidden fixed inset-0 z-50 items-center justify-center p-6\" data-kid=\"2-5\" id=\"payOverlay\" style=\"background:rgba(10,15,26,.7)\">\n        <div class=\"bg-[var(--c-card)] border-2 border-[var(--c-line)] w-full\" data-kid=\"2-5-1\" style=\"max-width:900px;border-radius:6px\">\n            <div class=\"flex items-center justify-between px-6 py-4 border-b-2 border-[var(--c-line)]\" data-kid=\"2-5-1-1\">\n                <div data-kid=\"2-5-1-1-1\">\n                    <div class=\"lbl\" data-kid=\"2-5-1-1-1-1\" style=\"color:var(--c-muted)\">\n                        Cobro · pedido #A-1043\n                    </div>\n                    <div data-kid=\"2-5-1-1-1-2\" style=\"font-size:26px;font-weight:800;line-height:1.15\">\n                        Registrar pago\n                    </div>\n                </div>\n                <button class=\"press grid place-items-center border-2 border-[var(--c-line)]\" data-kid=\"2-5-1-1-2\" data-name=\"pay modal close button\" id=\"payClose\" style=\"width:56px;height:56px;border-radius:6px\">\n                    <i class=\"ti ti-x text-[26px]\" data-kid=\"2-5-1-1-2-1\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex items-stretch\" data-kid=\"2-5-1-2\" id=\"payMain\">\n                <div class=\"p-6 border-r-2 border-[var(--c-line)]\" data-kid=\"2-5-1-2-1\" style=\"width:400px\">\n                    <div class=\"lbl mb-3\" data-kid=\"2-5-1-2-1-1\" style=\"color:var(--c-muted)\">\n                        Método de pago\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-3\" data-dynamic=\"true\" data-kid=\"2-5-1-2-1-2\" data-name=\"payment methods container\" data-reason=\"buttons dynamically injected by script\" id=\"payMethods\">\n                    </div>\n                    <div class=\"lbl mt-6 mb-3\" data-kid=\"2-5-1-2-1-3\" style=\"color:var(--c-muted)\">\n                        Total a cobrar\n                    </div>\n                    <div class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-5-1-2-1-4\" data-name=\"payment total amount\" data-reason=\"total updated by script\" id=\"payTotal\" style=\"font-size:44px;line-height:1\">\n                        $0.00\n                    </div>\n                </div>\n                <div class=\"p-6 flex-1\" data-kid=\"2-5-1-2-2\">\n                    <div class=\"flex items-end justify-between\" data-kid=\"2-5-1-2-2-1\">\n                        <span class=\"lbl\" data-kid=\"2-5-1-2-2-1-1\" style=\"color:var(--c-muted)\">\n                            Recibido\n                        </span>\n                        <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-5-1-2-2-1-2\" data-name=\"payment received amount\" data-reason=\"amount updated by script\" id=\"payRecv\" style=\"font-size:56px;line-height:1\">\n                            $0\n                        </span>\n                    </div>\n                    <div class=\"grid grid-cols-4 gap-0 mt-4 border-2 border-[var(--c-line)]\" data-kid=\"2-5-1-2-2-2\" style=\"border-radius:6px;overflow:hidden\">\n                        <button class=\"press quick border-r-2 border-[var(--c-line)] tnum\" data-kid=\"2-5-1-2-2-2-1\" data-q=\"200\" style=\"height:56px;font-size:16px\">\n                            $200\n                        </button>\n                        <button class=\"press quick border-r-2 border-[var(--c-line)] tnum\" data-kid=\"2-5-1-2-2-2-2\" data-q=\"500\" style=\"height:56px;font-size:16px\">\n                            $500\n                        </button>\n                        <button class=\"press quick border-r-2 border-[var(--c-line)] tnum\" data-kid=\"2-5-1-2-2-2-3\" data-q=\"1000\" style=\"height:56px;font-size:16px\">\n                            $1000\n                        </button>\n                        <button class=\"press quick\" data-kid=\"2-5-1-2-2-2-4\" data-q=\"exact\" style=\"height:56px;font-size:13px;font-weight:800\">\n                            EXACTO\n                        </button>\n                    </div>\n                    <div class=\"grid grid-cols-3 mt-4 border-2 border-[var(--c-line)]\" data-dynamic=\"true\" data-kid=\"2-5-1-2-2-3\" data-name=\"payment numpad container\" data-reason=\"buttons dynamically injected by script\" id=\"numpad\" style=\"border-radius:6px;overflow:hidden\">\n                    </div>\n                    <div class=\"mt-4 flex items-center justify-between px-5 text-white bg-[var(--c-cancelado)]\" data-kid=\"2-5-1-2-2-4\" id=\"changeBox\" style=\"height:76px;border-radius:6px\">\n                        <span class=\"lbl\" data-kid=\"2-5-1-2-2-4-1\">\n                            Faltan por cubrir\n                        </span>\n                        <span class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-5-1-2-2-4-2\" data-name=\"payment change amount\" data-reason=\"amount updated by script\" id=\"changeAmt\" style=\"font-size:32px\">\n                            $0.00\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <button class=\"press w-full bg-[var(--c-brand)] text-white disabled:opacity-40\" data-dynamic=\"true\" data-kid=\"2-5-1-3\" data-name=\"pay confirm button\" data-reason=\"disabled state updated by script\" id=\"payConfirm\" style=\"height:76px;font-size:20px;font-weight:800\">\n                CONFIRMAR COBRO\n            </button>\n            <div class=\"hidden p-10 text-center\" data-dynamic=\"true\" data-kid=\"2-5-1-4\" data-name=\"payment success screen\" data-reason=\"display toggled by script\" id=\"paySuccess\">\n                <div class=\"ok-pop grid place-items-center mx-auto bg-[var(--c-listo)] text-white\" data-kid=\"2-5-1-4-1\" style=\"width:96px;height:96px;border-radius:6px\">\n                    <i class=\"ti ti-check text-[56px]\" data-kid=\"2-5-1-4-1-1\">\n                    </i>\n                </div>\n                <div class=\"mt-5\" data-kid=\"2-5-1-4-2\" style=\"font-size:30px;font-weight:800\">\n                    Cobro registrado\n                </div>\n                <div class=\"lbl mt-2\" data-kid=\"2-5-1-4-3\" style=\"color:var(--c-muted)\">\n                    Pedido #A-1043 ·\n                    <span data-dynamic=\"true\" data-kid=\"2-5-1-4-3-1\" data-name=\"ok payment method\" data-reason=\"text updated by script\" id=\"okMethod\">\n                        Efectivo\n                    </span>\n                </div>\n                <div class=\"mt-6 inline-flex items-center gap-6 border-2 border-[var(--c-line)] px-8 py-5\" data-kid=\"2-5-1-4-4\" style=\"border-radius:6px\">\n                    <div class=\"text-left\" data-kid=\"2-5-1-4-4-1\">\n                        <div class=\"lbl\" data-kid=\"2-5-1-4-4-1-1\" style=\"color:var(--c-muted)\">\n                            Cobrado\n                        </div>\n                        <div class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-5-1-4-4-1-2\" data-name=\"ok total amount\" data-reason=\"amount updated by script\" id=\"okTotal\" style=\"font-size:30px\">\n                            $0.00\n                        </div>\n                    </div>\n                    <div class=\"bg-[var(--c-line-soft)]\" data-kid=\"2-5-1-4-4-2\" style=\"width:2px;height:48px\">\n                    </div>\n                    <div class=\"text-left\" data-kid=\"2-5-1-4-4-3\">\n                        <div class=\"lbl\" data-kid=\"2-5-1-4-4-3-1\" style=\"color:var(--c-muted)\">\n                            Cambio a devolver\n                        </div>\n                        <div class=\"tnum\" data-dynamic=\"true\" data-kid=\"2-5-1-4-4-3-2\" data-name=\"ok change amount\" data-reason=\"amount updated by script\" id=\"okChange\" style=\"font-size:30px;color:var(--c-listo)\">\n                            $0.00\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-8 grid grid-cols-2 gap-4\" data-kid=\"2-5-1-4-5\">\n                    <button class=\"press border-2 border-[var(--c-line)] flex items-center justify-center gap-2\" data-kid=\"2-5-1-4-5-1\" id=\"okPrint\" style=\"height:64px;font-size:14px;font-weight:800;border-radius:6px\">\n                        <i class=\"ti ti-printer text-[22px]\" data-kid=\"2-5-1-4-5-1-1\">\n                        </i>\n                        IMPRIMIR TICKET\n                    </button>\n                    <button class=\"press bg-[var(--c-ink)] text-white flex items-center justify-center gap-2\" data-kid=\"2-5-1-4-5-2\" id=\"okNew\" style=\"height:64px;font-size:14px;font-weight:800;border-radius:6px\">\n                        <i class=\"ti ti-plus text-[22px]\" data-kid=\"2-5-1-4-5-2-1\">\n                        </i>\n                        NUEVO PEDIDO\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script>\n    (function(){\n  const IMG = 'https://images.pexels.com/photos/';\n  const q = '?auto=compress&cs=tinysrgb&w=480&q=80';\n  const px = (p, a) => ({src: IMG + p + q, alt: a});\n\n  const CATS = [\n    {id:'top',        name:'MÁS VENDIDOS', icon:'ti-flame'},\n    {id:'alitas',     name:'ALITAS',       icon:'ti-meat'},\n    {id:'boneless',   name:'BONELESS',     icon:'ti-grill'},\n    {id:'hamburguesas',name:'HAMBURGUESAS',icon:'ti-burger'},\n    {id:'vegetales',  name:'VEGETALES',    icon:'ti-salad'},\n    {id:'entradas',   name:'ENTRADAS',     icon:'ti-bowl'},\n    {id:'bebidas',    name:'BEBIDAS',      icon:'ti-cup'},\n    {id:'postres',    name:'POSTRES',      icon:'ti-cake'}\n  ];\n\n  const P = [\n    {id:1, n:'Alitas 10',            p:180, c:'alitas',       tag:'ALITAS', top:true,  cust:true,  ...px('36863581/pexels-photo-36863581.jpeg','Canasta de alitas crujientes — foto de César O\\u2019neill en Pexels')},\n    {id:2, n:'Alitas 15',            p:250, c:'alitas',       tag:'ALITAS', top:false, cust:false, ...px('36863573/pexels-photo-36863573.jpeg','Alitas con papas — foto de César O\\u2019neill en Pexels')},\n    {id:3, n:'Alitas 20',            p:320, c:'alitas',       tag:'ALITAS', top:false, cust:false, ...px('4061475/pexels-photo-4061475.jpeg','Canasta de alitas crujientes — foto de Erik Mclean en Pexels')},\n    {id:4, n:'Boneless grande',      p:160, c:'boneless',     tag:'BONELESS', top:true, cust:true, ...px('10648379/pexels-photo-10648379.jpeg','Boneless dorados — foto de Angelo Greñas en Pexels')},\n    {id:5, n:'Boneless mediano',     p:110, c:'boneless',     tag:'BONELESS', top:false,cust:false,...px('36879217/pexels-photo-36879217.jpeg','Pollo crujiente frito — foto de Mahmut Zeytin en Pexels')},\n    {id:6, n:'Hamburguesa clásica',  p:95,  c:'hamburguesas', tag:'BURGER', top:false, cust:false, ...px('10679778/pexels-photo-10679778.jpeg','Hamburguesa con papas — foto de Lucas Andrade en Pexels')},\n    {id:7, n:'Hamburguesa especial', p:120, c:'hamburguesas', tag:'BURGER', top:true,  cust:true,  ...px('38896826/pexels-photo-38896826.jpeg','Hamburguesa gourmet con queso — foto de Mike C en Pexels')},\n    {id:8, n:'Hamburguesa doble',    p:150, c:'hamburguesas', tag:'BURGER', top:false, cust:false, ...px('4109133/pexels-photo-4109133.jpeg','Dos hamburguesas con queso — foto de Polina Tankilevitch en Pexels')},\n    {id:9, n:'Hamburguesa de pollo', p:105, c:'hamburguesas', tag:'BURGER', top:false, cust:false, ...px('983297/pexels-photo-983297.jpeg','Hamburguesa de pollo — foto de Kristina Paukshtite en Pexels')},\n    {id:10,n:'Ensalada César',       p:80,  c:'vegetales',    tag:'VERDE',  top:false, cust:false, ...px('5848038/pexels-photo-5848038.jpeg','Plato fresco servido — foto de Polina Tankilevitch en Pexels')},\n    {id:11,n:'Papas a la francesa',  p:60,  c:'vegetales',    tag:'VERDE',  top:false, cust:false, ...px('4109259/pexels-photo-4109259.jpeg','Papas a la francesa doradas — foto de Polina Tankilevitch en Pexels')},\n    {id:12,n:'Dedos de queso',       p:85,  c:'entradas',     tag:'ENTRADA',top:false, cust:false, ...px('4109116/pexels-photo-4109116.jpeg','Entrada de comida rápida — foto de Polina Tankilevitch en Pexels')},\n    {id:13,n:'Aros de cebolla',      p:70,  c:'entradas',     tag:'ENTRADA',top:false, cust:false, ...px('4109258/pexels-photo-4109258.jpeg','Aros y papas fritas — foto de Polina Tankilevitch en Pexels')},\n    {id:14,n:'Refresco',             p:35,  c:'bebidas',      tag:'BEBIDA', top:true,  cust:false, ...px('4109236/pexels-photo-4109236.jpeg','Bebida y comida servida — foto de Polina Tankilevitch en Pexels')},\n    {id:15,n:'Agua fresca 1L',       p:45,  c:'bebidas',      tag:'BEBIDA', top:false, cust:false, ...px('20329559/pexels-photo-20329559.jpeg','Bebida fría servida en mesa — foto de Doğu Tuncer en Pexels')},\n    {id:16,n:'Pastel de chocolate',  p:65,  c:'postres',      tag:'POSTRE', top:false, cust:false, ...px('14773000/pexels-photo-14773000.jpeg','Postre servido en plato — foto de Smit Karkar en Pexels')}\n  ];\n\n  const MODS = [\n    {id:'salsa', label:'SALSA', multi:false, opts:[\n      {id:'bbq', n:'BBQ', p:0},{id:'buf', n:'Búfalo', p:0},{id:'man', n:'Mango habanero', p:0},{id:'lim', n:'Limón pimienta', p:0}\n    ]},\n    {id:'aderezo', label:'ADEREZO', multi:true, opts:[\n      {id:'ranch', n:'Ranch', p:15},{id:'azul', n:'Queso azul', p:18}\n    ]},\n    {id:'extras', label:'EXTRAS', multi:true, opts:[\n      {id:'queso', n:'Extra queso', p:12},{id:'doble', n:'Doble carne', p:35},{id:'cebolla', n:'Sin cebolla', p:0}\n    ]}\n  ];\n\n  const money = n => '$' + n.toLocaleString('es-MX',{minimumFractionDigits:2, maximumFractionDigits:2});\n  const $ = s => document.querySelector(s);\n\n  let activeCat = 'top';\n  let term = '';\n  let order = [];\n\n  /* ---------- categorías ---------- */\n  const catsEl = $('#cats');\n  const countOf = id => id === 'top' ? P.filter(p=>p.top).length : P.filter(p=>p.c===id).length;\n  catsEl.innerHTML = CATS.map(c => `\n    <button class=\"catbtn press flex-1 flex flex-col items-center justify-center gap-1 text-white border-r-2 border-white/15\" data-cat=\"${c.id}\" data-active=\"${c.id===activeCat}\">\n      <i class=\"ti ${c.icon} text-[26px]\"></i>\n      <span style=\"font-size:13px;font-weight:800;letter-spacing:.04em\">${c.name} <span class=\"tnum\">(${countOf(c.id)})</span></span>\n    </button>`).join('');\n  catsEl.addEventListener('click', e => {\n    const b = e.target.closest('[data-cat]'); if(!b) return;\n    activeCat = b.dataset.cat;\n    catsEl.querySelectorAll('[data-cat]').forEach(x => x.dataset.active = (x.dataset.cat===activeCat));\n    renderGrid();\n  });\n\n  /* ---------- grid ---------- */\n  const gridEl = $('#grid');\n  function visible(){\n    return P.filter(p => {\n      const inCat = term ? true : (activeCat==='top' ? p.top : p.c===activeCat);\n      const inTerm = !term || p.n.toLowerCase().includes(term);\n      return inCat && inTerm;\n    });\n  }\n  function renderGrid(){\n    const list = visible();\n    $('#gridCount').textContent = list.length;\n    gridEl.innerHTML = list.map(p => `\n      <button class=\"tile press relative overflow-hidden border-2 border-[var(--c-line)] text-left text-white\" data-id=\"${p.id}\" style=\"border-radius:6px;aspect-ratio:1/1\">\n        <img src=\"${p.src}\" alt=\"${p.alt}\" loading=\"lazy\" decoding=\"async\" class=\"absolute inset-0 w-full h-full object-cover\">\n        <span class=\"absolute inset-0\" style=\"background:linear-gradient(180deg, rgba(10,15,26,0) 0%, rgba(10,15,26,.78) 62%, rgba(10,15,26,.94) 100%)\"></span>\n        <span class=\"absolute top-0 left-0 bg-[var(--c-ink)] px-2 py-1\" style=\"font-size:10px;font-weight:800;letter-spacing:.08em;border-bottom-right-radius:6px\">${p.tag}</span>\n        ${p.cust ? `<span class=\"absolute top-2 right-2 grid place-items-center bg-white text-[var(--c-ink)]\" style=\"width:36px;height:36px;border-radius:6px\"><i class=\"ti ti-adjustments-alt text-[22px]\"></i></span>` : ''}\n        <span class=\"absolute left-0 right-0 bottom-0 p-3 block\">\n          <span class=\"block\" style=\"font-size:18px;font-weight:800;line-height:1.15\">${p.n}</span>\n          <span class=\"tnum block mt-1\" style=\"font-size:22px\">${money(p.p)}</span>\n        </span>\n      </button>`).join('');\n  }\n  gridEl.addEventListener('click', e => {\n    const b = e.target.closest('[data-id]'); if(!b) return;\n    const p = P.find(x => x.id === +b.dataset.id);\n    if(p.cust) openMods(p); else addLine(p, [], 1);\n  });\n\n  $('#search').addEventListener('input', e => { term = e.target.value.trim().toLowerCase(); renderGrid(); });\n\n  /* ---------- ticket ---------- */\n  const listEl = $('#ticketList');\n  const keyOf = (p, sel) => p.id + '|' + sel.map(s=>s.id).sort().join(',');\n\n  function addLine(p, sel, qty){\n    const k = keyOf(p, sel);\n    const found = order.find(l => l.k === k);\n    const unit = p.p + sel.reduce((a,s)=>a+s.p,0);\n    if(found) found.q += qty; else order.push({k, id:p.id, n:p.n, unit, q:qty, mods:sel.map(s=>s.p ? `${s.n} +${money(s.p)}` : s.n)});\n    renderTicket();\n  }\n  function renderTicket(){\n    if(!order.length){\n      listEl.innerHTML = `\n        <div class=\"h-full grid place-content-center justify-items-center px-8 text-center gap-3\">\n          <span class=\"grid place-items-center border-2 border-[var(--c-line-soft)]\" style=\"width:64px;height:64px;border-radius:6px\"><i class=\"ti ti-basket text-[30px] text-[var(--c-muted)]\"></i></span>\n          <span class=\"lbl\" style=\"color:var(--c-muted)\">Pedido vacío</span>\n          <span style=\"font-size:14px;font-weight:700;color:var(--c-muted);max-width:220px\">Toca un producto del catálogo para agregarlo</span>\n        </div>`;\n    } else {\n      listEl.innerHTML = order.map(l => `\n        <div class=\"flex items-center gap-3 px-4 border-b-2 border-[var(--c-line-soft)]\" style=\"min-height:76px\" data-k=\"${l.k}\">\n          <span class=\"shrink-0 grid place-items-center bg-[var(--c-ink)] text-white tnum\" style=\"width:44px;height:44px;border-radius:6px;font-size:18px\">${l.q}</span>\n          <span class=\"flex-1 min-w-0 block py-2\">\n            <span class=\"block truncate\" style=\"font-size:18px;font-weight:700\">${l.n}</span>\n            ${l.mods.length ? `<span class=\"block truncate\" style=\"font-size:13px;font-weight:700;color:var(--c-muted)\">${l.mods.join(' · ')}</span>` : ''}\n            <span class=\"tnum block\" style=\"font-size:18px\">${money(l.unit * l.q)}</span>\n          </span>\n          <button class=\"press shrink-0 grid place-items-center border-2 border-[var(--c-line)]\" data-dec=\"${l.k}\" style=\"width:56px;height:56px;border-radius:6px\">\n            <i class=\"ti ${l.q>1 ? 'ti-minus' : 'ti-trash'} text-[24px]\"></i>\n          </button>\n          <button class=\"press shrink-0 grid place-items-center border-2 border-[var(--c-line)]\" data-inc=\"${l.k}\" style=\"width:56px;height:56px;border-radius:6px\"><i class=\"ti ti-plus text-[24px]\"></i></button>\n        </div>`).join('');\n    }\n    const sub = order.reduce((a,l)=>a + l.unit*l.q, 0);\n    const count = order.reduce((a,l)=>a+l.q, 0);\n    $('#tCount').textContent = count;\n    $('#tSub').textContent = money(sub);\n    $('#tIva').textContent = money(sub * 0.16 / 1.16);\n    $('#tTotal').textContent = money(sub);\n    $('#cobrarAmt').textContent = sub ? money(sub) : '';\n    $('#btnCobrar').disabled = !sub;\n  }\n  listEl.addEventListener('click', e => {\n    const inc = e.target.closest('[data-inc]'), dec = e.target.closest('[data-dec]');\n    if(inc){ const l = order.find(x=>x.k===inc.dataset.inc); l.q++; renderTicket(); }\n    if(dec){ const l = order.find(x=>x.k===dec.dataset.dec); l.q--; if(l.q<=0) order = order.filter(x=>x.k!==l.k); renderTicket(); }\n  });\n\n  /* ---------- cronómetro ---------- */\n  let secs = 41;\n  setInterval(() => {\n    secs++;\n    const m = String(Math.floor(secs/60)).padStart(2,'0'), s = String(secs%60).padStart(2,'0');\n    $('#chrono').textContent = m + ':' + s;\n  }, 1000);\n\n  /* ---------- modal modificadores ---------- */\n  let curP = null, sel = {}, mQty = 1;\n  const modOverlay = $('#modOverlay');\n  function openMods(p){\n    curP = p; sel = {salsa:'bbq', aderezo:[], extras:[]}; mQty = 1;\n    $('#modTitle').textContent = p.n;\n    $('#modBody').innerHTML = MODS.map(g => `\n      <div>\n        <div class=\"flex items-center justify-between mb-3\">\n          <span class=\"lbl\">${g.label}</span>\n          <span class=\"lbl\" style=\"color:var(--c-muted)\">${g.multi ? 'Opción múltiple' : 'Elige una'}</span>\n        </div>\n        <div class=\"grid grid-cols-2 gap-3\">\n          ${g.opts.map(o => `\n            <button class=\"optbtn press flex items-center justify-between px-4 border-2 border-[var(--c-line)]\" data-g=\"${g.id}\" data-o=\"${o.id}\" data-on=\"${!g.multi && sel[g.id]===o.id}\" style=\"height:64px;border-radius:6px\">\n              <span style=\"font-size:16px;font-weight:700\">${o.n}</span>\n              <span class=\"tnum\" style=\"font-size:15px\">${o.p ? '+'+money(o.p) : ''}</span>\n            </button>`).join('')}\n        </div>\n      </div>`).join('') + `\n      <div>\n        <div class=\"lbl mb-3\">Comentario para cocina</div>\n        <textarea rows=\"2\" placeholder=\"Ej. bien dorado, salsa aparte\" class=\"w-full border-2 border-[var(--c-line)] px-4 py-3 outline-none bg-[var(--c-card)] placeholder:text-[var(--c-muted)]\" style=\"font-size:16px;font-weight:700;border-radius:6px\"></textarea>\n      </div>`;\n    priceMods();\n    modOverlay.classList.remove('hidden'); modOverlay.classList.add('flex');\n  }\n  function closeMods(){ modOverlay.classList.add('hidden'); modOverlay.classList.remove('flex'); }\n  function selected(){\n    const out = [];\n    MODS.forEach(g => {\n      g.opts.forEach(o => {\n        const on = g.multi ? sel[g.id].includes(o.id) : sel[g.id]===o.id;\n        if(on) out.push({id:g.id+':'+o.id, n:o.n, p:o.p});\n      });\n    });\n    return out;\n  }\n  function priceMods(){\n    const extra = selected().reduce((a,s)=>a+s.p,0);\n    $('#modPrice').textContent = money((curP.p + extra) * mQty);\n    $('#modQty').textContent = mQty;\n  }\n  $('#modBody').addEventListener('click', e => {\n    const b = e.target.closest('[data-o]'); if(!b) return;\n    const g = MODS.find(x=>x.id===b.dataset.g), o = b.dataset.o;\n    if(g.multi){\n      sel[g.id] = sel[g.id].includes(o) ? sel[g.id].filter(x=>x!==o) : sel[g.id].concat(o);\n      b.dataset.on = sel[g.id].includes(o);\n    } else {\n      sel[g.id] = o;\n      $('#modBody').querySelectorAll(`[data-g=\"${g.id}\"]`).forEach(x => x.dataset.on = (x.dataset.o===o));\n    }\n    priceMods();\n  });\n  $('#modPlus').addEventListener('click', ()=>{ mQty++; priceMods(); });\n  $('#modMinus').addEventListener('click', ()=>{ if(mQty>1){ mQty--; priceMods(); } });\n  $('#modAdd').addEventListener('click', ()=>{ addLine(curP, selected(), mQty); closeMods(); });\n  $('#modClose').addEventListener('click', closeMods);\n  modOverlay.addEventListener('click', e => { if(e.target===modOverlay) closeMods(); });\n\n  /* ---------- modal pago ---------- */\n  const payOverlay = $('#payOverlay');\n  const METHODS = [\n    {id:'efectivo', n:'EFECTIVO', i:'ti-cash'},\n    {id:'tarjeta', n:'TARJETA', i:'ti-credit-card'},\n    {id:'transferencia', n:'TRANSFERENCIA', i:'ti-building-bank'},\n    {id:'qr', n:'QR', i:'ti-qrcode'}\n  ];\n  let method = 'efectivo', recv = '';\n  $('#payMethods').innerHTML = METHODS.map(m => `\n    <button class=\"paybtn press grid place-content-center gap-2 border-2 border-[var(--c-line)]\" data-m=\"${m.id}\" data-on=\"${m.id===method}\" style=\"height:120px;border-radius:6px\">\n      <i class=\"ti ${m.i} text-[34px] block text-center\"></i>\n      <span style=\"font-size:13px;font-weight:800;letter-spacing:.04em\">${m.n}</span>\n    </button>`).join('');\n  $('#payMethods').addEventListener('click', e => {\n    const b = e.target.closest('[data-m]'); if(!b) return;\n    method = b.dataset.m;\n    $('#payMethods').querySelectorAll('[data-m]').forEach(x => x.dataset.on = (x.dataset.m===method));\n  });\n\n  const KEYS = ['1','2','3','4','5','6','7','8','9','00','0','del'];\n  $('#numpad').innerHTML = KEYS.map((k,i) => `\n    <button class=\"press key grid place-items-center border-[var(--c-line)] ${(i%3)!==2 ? 'border-r-2':''} ${i<9 ? 'border-b-2':''}\" data-k=\"${k}\" style=\"height:84px\">\n      ${k==='del' ? '<i class=\"ti ti-backspace text-[30px]\"></i>' : `<span class=\"tnum\" style=\"font-size:28px\">${k}</span>`}\n    </button>`).join('');\n  $('#numpad').addEventListener('click', e => {\n    const b = e.target.closest('[data-k]'); if(!b) return;\n    const k = b.dataset.k;\n    if(k==='del') recv = recv.slice(0,-1);\n    else if(recv.length < 7) recv += k;\n    paint();\n  });\n  document.querySelectorAll('.quick').forEach(b => b.addEventListener('click', () => {\n    const total = order.reduce((a,l)=>a+l.unit*l.q,0);\n    recv = b.dataset.q === 'exact' ? String(Math.round(total)) : b.dataset.q;\n    paint();\n  }));\n  function paint(){\n    const total = order.reduce((a,l)=>a+l.unit*l.q,0);\n    const r = Number(recv || 0);\n    $('#payTotal').textContent = money(total);\n    $('#payRecv').textContent = '$' + (recv ? Number(recv).toLocaleString('es-MX') : '0');\n    const diff = r - total;\n    const box = $('#changeBox');\n    if(diff < 0){\n      box.style.background = 'var(--c-cancelado)';\n      box.querySelector('.lbl').textContent = 'Faltan por cubrir';\n      $('#changeAmt').textContent = money(Math.abs(diff));\n      $('#payConfirm').disabled = true;\n    } else {\n      box.style.background = 'var(--c-listo)';\n      box.querySelector('.lbl').textContent = 'Cambio a devolver';\n      $('#changeAmt').textContent = money(diff);\n      $('#payConfirm').disabled = false;\n    }\n  }\n  $('#btnCobrar').addEventListener('click', () => {\n    recv = ''; paint();\n    $('#payMain').classList.remove('hidden');\n    $('#payConfirm').classList.remove('hidden');\n    $('#paySuccess').classList.add('hidden');\n    payOverlay.classList.remove('hidden'); payOverlay.classList.add('flex');\n  });\n  function closePay(){ payOverlay.classList.add('hidden'); payOverlay.classList.remove('flex'); }\n  $('#payClose').addEventListener('click', closePay);\n  payOverlay.addEventListener('click', e => { if(e.target===payOverlay) closePay(); });\n  $('#payConfirm').addEventListener('click', () => {\n    const total = order.reduce((a,l)=>a+l.unit*l.q,0);\n    $('#okTotal').textContent = money(total);\n    $('#okChange').textContent = money(Number(recv||0) - total);\n    $('#okMethod').textContent = (METHODS.find(m=>m.id===method)||{}).n;\n    $('#payMain').classList.add('hidden');\n    $('#payConfirm').classList.add('hidden');\n    $('#paySuccess').classList.remove('hidden');\n  });\n  $('#okNew').addEventListener('click', () => { order = []; renderTicket(); closePay(); });\n  $('#okPrint').addEventListener('click', closePay);\n\n  document.addEventListener('keydown', e => {\n    if(e.key === 'Escape'){ closeMods(); closePay(); }\n    if(e.key === 'F2'){ e.preventDefault(); $('#search').focus(); }\n  });\n\n  /* ---------- arranque con pedido de ejemplo ---------- */\n  addLine(P[0], [{id:'salsa:bbq', n:'BBQ', p:0},{id:'aderezo:ranch', n:'Ranch', p:15}], 1);\n  addLine(P[6], [], 1);\n  addLine(P[13], [], 2);\n  renderGrid();\n})();\n</script>\n",
      "comments": [],
      "created": "2026-08-18T00:44:02.847399+00:00",
      "modified": "2026-08-18T00:46:29.919858+00:00",
      "id": "var_e08b984d1500"
    },
    "var_c91a1c3e0a9e": {
      "type": "variant",
      "label": "POS · A · Sala de control",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap');\n\n.app{\n  --c-page:#EEF1F5;\n  --c-card:#FFFFFF;\n  --c-ink:#0B1220;\n  --c-ink-2:#334155;\n  --c-muted:#52627A;\n  --c-line:#CBD5E1;\n  --c-line-2:#E2E8F0;\n  --c-accent:#1D4ED8;\n  --c-nuevo:#1D4ED8;\n  --c-preparando:#B45309;\n  --c-listo:#15803D;\n  --c-cobrar:#334155;\n  --c-cancelado:#B91C1C;\n  font-family:'IBM Plex Sans',system-ui,sans-serif;\n  -webkit-font-smoothing:antialiased;\n}\n.app .mono{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums;font-feature-settings:\"tnum\" 1;}\n.app *:focus-visible{outline:2px solid var(--c-accent);outline-offset:2px;}\n.app .navitem:hover{background:rgba(255,255,255,.07);}\n.app .catrow:hover{background:var(--c-line-2);}\n.app .pcard:hover{border-color:var(--c-accent);box-shadow:inset 0 0 0 1px var(--c-accent);}\n.app .pcard:hover .plus{opacity:1;}\n.app .pcard:active{transform:translateY(1px);}\n.app .kpad button{border:1px solid var(--c-line);margin:-1px 0 0 -1px;}\n.app .kpad button:hover{background:var(--c-line-2);}\n.app .kpad button:active{background:var(--c-ink);color:#fff;}\n.app .scroll::-webkit-scrollbar{width:10px;height:10px;}\n.app .scroll::-webkit-scrollbar-thumb{background:var(--c-line);border-radius:6px;}\n.app .scroll::-webkit-scrollbar-track{background:transparent;}\n.app kbd{font-family:'IBM Plex Mono',monospace;font-size:10px;border:1px solid var(--c-line);border-bottom-width:2px;border-radius:4px;padding:2px 5px;color:var(--c-muted);background:#fff;}\n.app .okpop{animation:okpop .28s ease-out both;}\n@keyframes okpop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}\n.app .listview .pcard{display:grid;grid-template-columns:64px 1fr auto;align-items:center;height:64px;}\n.app .listview .pcard .pmedia{height:64px;width:64px;}\n.app .listview .pcard .pbody{padding:0 12px;text-align:left;}\n.app .listview .pcard .prow{display:flex;gap:10px;align-items:center;padding-right:14px;}\n.app .listview #grid{grid-template-columns:1fr 1fr;}\n</style>\n<div class=\"app w-full h-[900px] flex bg-[var(--c-page)] text-[var(--c-ink)] overflow-hidden text-[14px]\" data-kid=\"2\">\n    <!-- SIDEBAR -->\n    <aside class=\"w-[224px] shrink-0 bg-[var(--c-ink)] text-white flex flex-col\" data-kid=\"2-1\">\n        <div class=\"h-14 px-4 flex items-center gap-2.5 border-b border-white/10\" data-kid=\"2-1-1\">\n            <span class=\"w-6 h-6 rounded-[4px] bg-[var(--c-accent)] grid place-items-center text-[13px] font-bold\" data-kid=\"2-1-1-1\">\n                P\n            </span>\n            <span class=\"text-[15px] font-bold tracking-[0.02em]\" data-kid=\"2-1-1-2\">\n                POSTIA\n            </span>\n            <span class=\"mono ml-auto text-[10px] text-white/45\" data-kid=\"2-1-1-3\">\n                v1.0\n            </span>\n        </div>\n        <nav class=\"flex-1 overflow-y-auto scroll py-3\" data-kid=\"2-1-2\">\n            <p class=\"px-4 pb-1.5 text-[10px] font-semibold tracking-[0.12em] text-white/40\" data-kid=\"2-1-2-1\">\n                OPERACIÓN\n            </p>\n            <button class=\"navitem w-full h-11 px-4 flex items-center gap-3 text-[13.5px] text-white/75\" data-kid=\"2-1-2-2\">\n                <i class=\"ti ti-home text-[17px]\" data-kid=\"2-1-2-2-1\">\n                </i>\n                Inicio\n            </button>\n            <button class=\"w-full h-11 pl-[13px] pr-4 flex items-center gap-3 text-[13.5px] font-semibold text-white bg-white/[0.09] border-l-[3px] border-[var(--c-accent)]\" data-kid=\"2-1-2-3\">\n                <i class=\"ti ti-receipt text-[17px]\" data-kid=\"2-1-2-3-1\">\n                </i>\n                Pedidos\n                <span class=\"mono ml-auto text-[11px] text-white/60\" data-kid=\"2-1-2-3-2\">\n                    7\n                </span>\n            </button>\n            <button class=\"navitem w-full h-11 px-4 flex items-center gap-3 text-[13.5px] text-white/75\" data-kid=\"2-1-2-4\">\n                <i class=\"ti ti-chef-hat text-[17px]\" data-kid=\"2-1-2-4-1\">\n                </i>\n                Cocina\n                <span class=\"mono ml-auto text-[11px] text-white/45\" data-kid=\"2-1-2-4-2\">\n                    3\n                </span>\n            </button>\n            <button class=\"navitem w-full h-11 px-4 flex items-center gap-3 text-[13.5px] text-white/75\" data-kid=\"2-1-2-5\">\n                <i class=\"ti ti-table text-[17px]\" data-kid=\"2-1-2-5-1\">\n                </i>\n                Mesas\n                <span class=\"mono ml-auto text-[11px] text-white/45\" data-kid=\"2-1-2-5-2\">\n                    4/12\n                </span>\n            </button>\n            <button class=\"navitem w-full h-11 px-4 flex items-center gap-3 text-[13.5px] text-white/75\" data-kid=\"2-1-2-6\">\n                <i class=\"ti ti-cash text-[17px]\" data-kid=\"2-1-2-6-1\">\n                </i>\n                Caja\n            </button>\n            <p class=\"px-4 pt-4 pb-1.5 text-[10px] font-semibold tracking-[0.12em] text-white/40\" data-kid=\"2-1-2-7\">\n                CATÁLOGO\n            </p>\n            <button class=\"navitem w-full h-11 px-4 flex items-center gap-3 text-[13.5px] text-white/75\" data-kid=\"2-1-2-8\">\n                <i class=\"ti ti-package text-[17px]\" data-kid=\"2-1-2-8-1\">\n                </i>\n                Productos\n            </button>\n            <button class=\"navitem w-full h-11 px-4 flex items-center gap-3 text-[13.5px] text-white/75\" data-kid=\"2-1-2-9\">\n                <i class=\"ti ti-tags text-[17px]\" data-kid=\"2-1-2-9-1\">\n                </i>\n                Categorías\n            </button>\n            <button c